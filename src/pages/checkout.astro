---
import CustomerLayout from '../layouts/CustomerLayout.astro'
import CheckoutFlow from '../components/checkout/CheckoutFlow'

const customerId = Astro.url.searchParams.get('customer') || ''
const orderId = Astro.url.searchParams.get('order') || ''
---
<CustomerLayout title="ชำระเงิน">
  <CheckoutFlow
    client:only="react"
    customerId={customerId}
    orderId={orderId}
  />
</CustomerLayout>
