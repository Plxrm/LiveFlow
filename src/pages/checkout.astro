---
import CustomerLayout from '../layouts/CustomerLayout.astro'
import CheckoutPage from '../components/checkout/CheckoutPage'

const orderId = Astro.url.searchParams.get('order') || ''
---
<CustomerLayout title="กรอกที่อยู่จัดส่ง">
  <CheckoutPage
    client:only="react"
    orderId={orderId}
  />
</CustomerLayout>
