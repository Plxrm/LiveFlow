---
import AdminLayout from '../layouts/AdminLayout.astro'
import { APP_NAME } from '../lib/constants'
import DashboardPage from '../components/dashboard/DashboardPage'
import { getDashboardStats, getRecentOrders, getPendingPayments, getActiveLiveSession } from '../lib/api/dashboard'

const stats = await getDashboardStats()
const recentOrders = await getRecentOrders()
const pendingPayments = await getPendingPayments()
const liveSession = await getActiveLiveSession()
---

<AdminLayout title={`Dashboard | ${APP_NAME}`}>
  <DashboardPage
    client:only="react"
    statsData={JSON.stringify(stats)}
    recentOrdersData={JSON.stringify(recentOrders)}
    pendingPaymentsData={JSON.stringify(pendingPayments)}
    liveSessionData={JSON.stringify(liveSession)}
  />
</AdminLayout>
