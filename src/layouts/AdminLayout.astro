---
import Sidebar from '../components/admin/Sidebar'
import Header from '../components/admin/Header'
import { getOrderStats } from '../lib/api/orders'
import { APP_NAME } from '../lib/constants'
import '../styles/globals.css'

interface Props {
  title?: string
}

const { title = `${APP_NAME} | ระบบจัดการร้านค้าไลฟ์สด` } = Astro.props
const currentPath = Astro.url.pathname

// ดึง stats เพื่อแสดง badge จำนวน orders ที่รอจัดส่ง
let paidCount = 0
try {
  const stats = await getOrderStats()
  paidCount = stats.paid
} catch {
  paidCount = 0
}
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="ระบบจัดการ Live Commerce สำหรับธุรกิจออนไลน์" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased">
    <div class="min-h-screen bg-gray-50 flex">
      <Sidebar client:load currentPath={currentPath} pendingShipments={paidCount} />
      <div class="flex-1 md:ml-[260px] flex flex-col min-h-screen">
        <Header client:load />
        <main class="flex-1 p-4 md:p-6 lg:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
